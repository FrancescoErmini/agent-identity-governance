# Copy to .env and fill in. Never commit .env.
KC_ADMIN_PASSWORD=change-me
LITELLM_MASTER_KEY=sk-change-me
LITELLM_DB_PASSWORD=change-me
CRM_DB_PASSWORD=change-me
