{
  "realm": "ai-demo",
  "enabled": true,
  "displayName": "AI demo (synthetic)",
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_VIEW\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"territory\", \"displayName\": \"Territory\", \"validations\": {\"options\": {\"options\": [\"NORTH\", \"CENTRE\", \"SOUTH\"]}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "roles": {
    "client": {
      "demo-crm": [
        {
          "name": "rep",
          "description": "Sales rep: own territory, own notes"
        },
        {
          "name": "area-manager",
          "description": "Area manager: team reports (never reachable by an agent)"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "demo-crm",
      "name": "demo-crm (UI login, API audience)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://crm.demo.local:3000/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "aud-demo-crm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "demo-crm",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "territory",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "territory",
            "claim.name": "territory",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "litellm-proxy",
      "name": "LiteLLM gateway (audience only)",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "clientAuthenticatorType": "client-jwt",
      "fullScopeAllowed": false
    },
    {
      "clientId": "demo-cli",
      "name": "Test client (dev only, password grant for scripted checks)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "aud-demo-crm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "demo-crm",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "aud-litellm-proxy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "litellm-proxy",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "territory",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "territory",
            "claim.name": "territory",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "other-app",
      "name": "Unrelated app (dev only): its tokens must be refused",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false
    }
  ],
  "users": [
    {
      "username": "luca",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Luca",
      "lastName": "Bianchi",
      "email": "luca@demo.local",
      "attributes": {
        "territory": [
          "NORTH"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "luca",
          "temporary": false
        }
      ],
      "clientRoles": {
        "demo-crm": [
          "rep",
          "area-manager"
        ]
      }
    },
    {
      "username": "giulia",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Giulia",
      "lastName": "Russo",
      "email": "giulia@demo.local",
      "attributes": {
        "territory": [
          "CENTRE"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "giulia",
          "temporary": false
        }
      ],
      "clientRoles": {
        "demo-crm": [
          "rep"
        ]
      }
    },
    {
      "username": "marco",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Marco",
      "lastName": "Esposito",
      "email": "marco@demo.local",
      "attributes": {
        "territory": [
          "SOUTH"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "marco",
          "temporary": false
        }
      ],
      "clientRoles": {
        "demo-crm": [
          "rep"
        ]
      }
    }
  ],
  "scopeMappings": [],
  "clientScopeMappings": {
    "demo-crm": [
      {
        "client": "demo-crm",
        "roles": [
          "rep",
          "area-manager"
        ]
      },
      {
        "client": "demo-cli",
        "roles": [
          "rep",
          "area-manager"
        ]
      }
    ]
  }
}